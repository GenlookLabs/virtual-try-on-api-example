# Your key from https://platform.genlook.app (new accounts get 10 free credits)
GENLOOK_API_KEY=gk_your_key_here

# Optional: override the API base URL (defaults to production)
# GENLOOK_BASE_URL=https://api.genlook.app/tryon/v1

# "true" uses the mock engine: free and instant, returns your photo unchanged
GENLOOK_USE_MOCK=false
