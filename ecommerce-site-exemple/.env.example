# Get your API key at https://genlook.app/try-on/api
GENLOOK_API_KEY=gk_your_key_here

# Optional: override API base URL (defaults to production)
# GENLOOK_BASE_URL=https://api.genlook.app/tryon/v1

# Set to "true" to use the mock engine (free, instant — returns the uploaded photo as the result)
GENLOOK_USE_MOCK=true
